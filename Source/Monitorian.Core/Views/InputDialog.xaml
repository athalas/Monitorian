<Window x:Class="Monitorian.Core.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Height="140" Width="360" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Text="Prompt"/>
        <TextBox x:Name="ResponseTextBox" Grid.Row="1" Margin="0,8,0,8"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="80" Margin="4,0" IsDefault="True" Click="Ok_Click">OK</Button>
            <Button Width="80" Margin="4,0" IsCancel="True">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>